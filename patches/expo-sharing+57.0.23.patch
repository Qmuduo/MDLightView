+package expo.modules.sharing
+
+/** Selects the single-file URI from Android's two common ACTION_SEND URI locations. */
+internal fun selectSharedStreamUri(extraStream: String?, clipDataUri: String?): String? =
+  extraStream ?: clipDataUri
