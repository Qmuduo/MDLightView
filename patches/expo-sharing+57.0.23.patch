+package expo.modules.sharing
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class ShareStreamUriSelectorTest {
+  @Test
+  fun `uses ClipData URI when EXTRA_STREAM is absent`() {
+    assertEquals(
+      "content://provider/document/42",
+      selectSharedStreamUri(extraStream = null, clipDataUri = "content://provider/document/42")
+    )
+  }
+
+  @Test
+  fun `prefers EXTRA_STREAM when both URI sources are present`() {
+    assertEquals(
+      "content://provider/extra-stream",
+      selectSharedStreamUri(
+        extraStream = "content://provider/extra-stream",
+        clipDataUri = "content://provider/clip-data"
+      )
+    )
+  }
+
+  @Test
+  fun `returns no URI when neither source is present`() {
+    assertNull(selectSharedStreamUri(extraStream = null, clipDataUri = null))
+  }
+}
