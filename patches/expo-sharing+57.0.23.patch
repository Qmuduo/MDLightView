     private fun handleSendAction(context: Context, intent: Intent, type: String): List<SharePayload> {
+      // File providers may label a Markdown document as text/plain and only provide a URI stream.
+      val extraStream = intent.getParcelableExtraCompat<Uri>(Intent.EXTRA_STREAM)?.toString()
+      val clipDataStream = intent.clipData
+        ?.takeIf { it.itemCount > 0 }
+        ?.getItemAt(0)
+        ?.uri
+        ?.toString()
+      val stream = selectSharedStreamUri(extraStream, clipDataStream)?.let { Uri.parse(it) }
+      if (stream != null) {
+        return listOf(createUriPayload(context, stream, type))
+      }
       return if (type == "text/plain") {
